{
  "name": "syndicate-ledger",
  "version": "0.2.0",
  "private": true,
  "description": "A Sudoku-style detective puzzle game: crack the syndicate's ledgers, catch the liars, close the case.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build && node -e \"require('fs').renameSync('dist/index.html', 'dist/syndicate-ledger.html')\"",
    "build:site": "bash scripts/build-site.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "generate": "tsx scripts/generate-puzzles.ts",
    "validate": "tsx scripts/validate-case.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "e2e": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
