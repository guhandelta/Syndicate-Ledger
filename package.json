{
  "name": "syndicate-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "A Sudoku-style detective puzzle game: crack the syndicate's ledgers, catch the liars, close the case.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').renameSync('dist/index.html', 'dist/syndicate-ledger.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "generate": "tsx scripts/generate-puzzles.ts",
    "validate": "tsx scripts/validate-case.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4"
  }
}
